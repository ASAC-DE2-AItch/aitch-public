# =============================================================================
# 능동형 제조 AI 플랫폼 v4 — 프로젝트 환경변수 설정
# =============================================================================
# .env.example 을 복사하여 .env 로 만든 뒤, 실제 키값을 채워 넣으세요.
# .env 파일은 .gitignore에 추가하여 커밋하지 않습니다.
# =============================================================================

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=fdc.raw
KAFKA_TOPIC_PREDICTION=fdc.prediction
KAFKA_TOPIC_ALERT=fdc.alert
KAFKA_TOPIC_R2R=fdc.correction    # 계약 토픽명 정합(구 fdc.r2r). ※ KAFKA_TOPIC_* 는 현재 어떤 코드도 읽지 않음(토픽명=모듈 상수) — 문서 위생
KAFKA_TOPIC_AGENT=fdc.agent
KAFKA_TOPIC_MLOPS=fdc.mlops

# --- SPC (팀원 B, B6-2) ---
SPC_REQUALIFIED_LIVE=false        # ChamberRequalified 발행 토글 (데모/오케스트레이터 발행 시 true)

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=fdc_admin
DB_PASSWORD=fdc_pass_2026
DB_NAME=fdc_platform
DATABASE_URL=postgresql://fdc_admin:fdc_pass_2026@localhost:5432/fdc_platform

# --- LLM API (팀원 C, D 전용) ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- LLM 로컬 서빙 (Ollama — 실험/폴백 경로. 프로덕션은 vLLM) ---
OLLAMA_HOST=http://localhost:11434

# =============================================================================
# Agent Service (팀원 C) — 운용 스위치 + LLM 엔드포인트
#   단일 소스: src/agent_service/app/config.py
#   알고리즘 값(temperature·max_tokens 등)은 여기가 아니라 config/params.yaml (헌법 6-1)
# =============================================================================

# --- 스위치 3종 (각 계층을 mock↔real 로 갈아끼우는 경계) ---
# SOURCE: replay(fixtures 재생) | kafka(실제 구독)     — 미설정 시 replay
AGENT_SOURCE_MODE=replay
# API   : mock(스텁) | real(B 실력치 엔진·A 예측 실호출) — 미설정 시 mock
AGENT_API_MODE=mock
# LLM   : ollama | api(vLLM)                          — 미설정 시 ollama
#   ⚠️ 운영/시연은 api(vLLM) 권장 — Ollama /v1 은 guided_json·thinking 억제가 안 먹어
#      qwen3.6(thinking 모델)이 사고에 토큰을 소진해 JSON 이 빈다 (2026-07-16 실측:
#      동시 24호출에서 Ollama JSON 유효율 0.0 / p95 236s ↔ vLLM 1.0 / p95 13.1s)
AGENT_LLM_MODE=api

# --- LLM 엔드포인트 (배포마다 바뀌는 인프라 값이라 params.yaml 이 아니라 .env) ---
#   미설정이면 백엔드 생성 시 명시적 에러(조용한 기본값 금지 — params.yaml 정책과 동일)
#   · vLLM   : http://<ip>:8000    (프로덕션 — D13)
#   · Ollama : http://localhost:11434 (로컬 실험)
#   실주소 얻기: cd src/agent_service/infra/llm-ec2-experiment
#                terraform apply   →  terraform output -raw vllm_endpoint
#                ※ 끝나면 반드시 terraform destroy (GPU 방치 = 비용)
AGENT_LLM_BASE_URL=http://localhost:11434

# --- 게이트웨이 (RTD 해제 근거 Brief 트리거 — 인프라 스텝 3 · #140) ---
#   `GET /chambers/status` 로 열린 inhibit(자동 정지)을 읽는다. 계약 §9 가 그 엔드포인트를
#   열린 inhibit 의 **단일 소스**로 못박아서, 같은 판정을 DB 로 다시 구현하지 않는다.
#   compose 안에서는 서비스명(http://gateway:8000), 호스트에서는 localhost.
AGENT_GATEWAY_BASE_URL=http://localhost:8000

# --- Qdrant (벡터 DB — FAISS 대체, 헌법 4-2 v4.3) ---
# 서버 모드: QDRANT_URL 사용 (docker compose 기동). 인프로세스 로컬 모드: QDRANT_PATH 지정(도커 불필요).
QDRANT_URL=http://localhost:6333
# QDRANT_PATH=./data/qdrant_local

# --- 시뮬레이터 ---
SIMULATOR_CSV_PATH=./Data/문제1(하)/train_data.csv
SIMULATOR_DELAY_SEC=1.0

# --- lean-85 예측 consumer (팀원 A — PR②, 계획 §3-2 시연 안전망) ---
PREDICTION_MODE=lean85                  # lean85 | dummy (모델 로드 실패 시 자동 dummy 폴백)
LEAN85_MODEL_DIR=                       # 빈값 = params.yaml lean85.model_search_glob(models/c65_predictor/*/lean85_*) 최신 자동 선택
LEAN85_PM_LOG=                          # 빈값 = find_file 탐색. 운영 소스는 §6-2 회의 확정 대기
LEAN85_TIME_SOURCE=wall_clock           # wall_clock | src_ts — C40 원본시각 소스 (§6-2 안건)
LEAN85_AE_MODE=dummy                    # dummy | live — live면 ae_v3 실추론(drift/anomaly 실값), 로드 실패 시 더미 폴백 (A3-3)
AE_BUNDLE_DIR=                          # 빈값 = params.yaml anomaly_ae.bundle_search_glob(models/anomaly_ae/ae_*) 최신 자동 선택
AE_PUBLISH_EXT=0                        # 🆕 AE 확장 필드(ae_raw·ae_top_channels 등) — §2-2 소비자 승인 후 1
AE_OFFSET_CORRECT=0                     # 🆕 AE 입력 챔버 기준선 보정(config/chamber_offsets.json 차감) — drift/anomaly 의미가 바뀐다(계약 §2), 소비자 공지 후 1
LEAN85_PUBLISH_LOW_CONFIDENCE=0         # 🆕 계약 필드 — §2-2 소비자 승인 후 1

# --- CT⓪ Model R2R (팀원 A — 설계 docs/CT0_ModelR2R_설계방향_v1.md) ---
#   ⚠ 보정의 on/off 는 여기가 아니라 **config/params.yaml `ct.model_r2r.mode`** 다 (단일 소스).
#     아래는 경로·주기 같은 인프라 값만 (헌법 6-1).
CT0_BIAS_DIR=                           # 빈값 = <repo>/control/ct0 (updater → consumer 단방향 채널)
CT0_TRAIN_RMSE=                         # 빈값 = champion 메타에서 해석 (clamp 분모 override용)
CT0_BIAS_MAX_AGE_SEC=86400              # bias 파일 미갱신 경고 임계(초) — 0이면 비활성
CT0_JOIN_RETRY_SEC=1.0                  # 예측 행 지연 도착 시 재시도 대기(초) — 0이면 즉시 skip
CT0_ALLOW_OFF=                          # 1이면 mode=off 여도 updater 기동 (배선 점검 전용)
LEAN85_CT0_CHECK_EVERY=30               # consumer 가 poll N회마다 bias 파일 스캔 (mode=active 일 때만)

# vLLM --max-model-len (must match terraform.tfvars). client.py uses it for the 400 pre-warning.
AGENT_LLM_MAX_MODEL_LEN=12288
